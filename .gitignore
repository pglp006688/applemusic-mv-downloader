# .gitignore — 适用于 Apple Music MV Downloader (Python/Tkinter + gamdl)
# 忽略运行/开发过程中产生的临时文件、虚拟环境、IDE 配置和敏感凭证。

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# C extensions
*.so
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/

# IDE / editor
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs and databases
*.log
logs/
*.sqlite3
*.db
*.db-journal

# Test / coverage
.coverage
htmlcov/
.tox/
.pytest_cache/

# PyInstaller
*.spec

# Secrets and environments
.env
.env.*
*.pem
*.key
*.crt

# Jupyter
.ipynb_checkpoints

# Temp / download fragments (yt-dlp / gamdl)
*.part
*.part-*
*.part.*
*Frag*
*.m3u8.tmp

# gamdl / script-specific temp & outputs
gamdl_temp/
*/gamdl_temp/
C:/gamdl_temp/
C:\gamdl_temp/

# 常见输出目录（脚本默认示例）
Apple Music/
Apple\ Music/

# cookies / credential files (不要将 cookies 上传到仓库)
cookies.txt
*.cookies

# Editor backup / swap
*~
*.swp
*.swo
*.bak

# Coverage / profiling
.prof
coverage.xml

# Others
local_settings.py
Pipfile.lock
poetry.lock
.mypy_cache/